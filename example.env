BIN_DIR=bin/
OBJ_DIR=obj/

DISK_IMAGE_SIZE=65536

TARGET=i686-elf
CROSS_COMPILER_LOC=./cross/bin

CC=${CROSS_COMPILER_LOC}/${TARGET}-gcc
LD=${CROSS_COMPILER_LOC}/${TARGET}-ld
AR=${CROSS_COMPILER_LOC}/${TARGET}-ar
AS=nasm

# kernel configs

KERNEL_START=0xc0000000
KERNEL_STACK_SIZE=0x2000
# default eflags reg when creating a process
DEFAULT_EFLAGS=0x202
# maximum files a process can open
MAX_FILE=128
# how many ticks a process will run before got switch to others
PROCESS_ALIVE_TICKS=4
# address reserved for a temporary page table mapping
VMMNGR_TEMP_TABLE=0xc03fe000
# address reserved for editing page directories
VMMNGR_TEMP_PD=0xc03ff000
VIDEO_START=0xc0400000
# kernel heap
KHEAP_START=0xc0800000
KHEAP_INITIAL_SIZE=0x100000
KHEAP_MAX_SIZE=0x1000000
# ramfs heap
RHEAP_START=0xc1800000
RHEAP_INITIAL_SIZE=0x100000
RHEAP_MAX_SIZE=0x1000000
# user stuff
USER_STACK_TOP=$(KERNEL_START)
USER_STACK_SIZE=0x10000
ARGS_MAX_LEN=1024
ENVS_MAX_LEN=4096
